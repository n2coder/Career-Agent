# Copy to .env and fill in real values for local development.
# Never commit .env — it is gitignored.

# LLM provider: "openai" or "hf"
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY

# HuggingFace (only needed when LLM_PROVIDER=hf)
# HUGGINGFACE_API_KEY=REPLACE_WITH_HF_KEY
# HF_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2

# API protection (set to false for local dev; always true in production)
API_KEY_REQUIRED=false
APP_API_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Monitoring (optional for local dev)
MONITORING_KEY_REQUIRED=false
# MONITORING_API_KEY=REPLACE_WITH_MONITORING_SECRET

# Limits and tuning (defaults shown)
MAX_UPLOAD_BYTES=5242880
MAX_QUERY_BYTES=20000
SESSION_TTL_SEC=3600
MAX_SESSIONS=500
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_QUERY_PER_WINDOW=30
RATE_LIMIT_UPLOAD_PER_WINDOW=10

# Voice engine (STT/TTS)
# STT provider: "deepgram" (recommended, lower latency) or "openai" (Whisper)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=REPLACE_WITH_DEEPGRAM_KEY
# TTS — reuses OPENAI_API_KEY above
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=1.3
# JWT secret for voice session tokens (change this!)
SESSION_JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET
# Redis for voice conversation history (optional — works without it)
REDIS_SESSION_ENABLED=false
# REDIS_URL=redis://localhost:6379/0
