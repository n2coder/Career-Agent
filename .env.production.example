# Copy to .env.production and set real secrets.

# API security
API_KEY_REQUIRED=true
APP_API_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# API surface hardening
DISABLE_DOCS=true
ALLOW_NULL_ORIGIN=false
CORS_ORIGINS=https://career.example.com

# Runtime and trust
TRUST_X_FORWARDED_FOR=true
# Comma-separated trusted proxy source IPs/CIDRs that are allowed to supply X-Forwarded-For.
# Example for local docker reverse proxy:
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_QUERY_PER_WINDOW=30
RATE_LIMIT_UPLOAD_PER_WINDOW=10
MAX_UPLOAD_BYTES=5242880
MAX_QUERY_BYTES=20000
SESSION_TTL_SEC=3600
MAX_SESSIONS=500

# LLM provider
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY

# Monitoring security (recommended)
MONITORING_KEY_REQUIRED=true
MONITORING_API_KEY=REPLACE_WITH_SEPARATE_MONITORING_SECRET
# Optional allowlist (exact IPs and/or CIDRs, comma-separated)
# MONITORING_ALLOWED_IPS=203.0.113.10,198.51.100.0/24
MONITORING_RETENTION_SEC=259200
MONITORING_CAPTURE_QUERY_TEXT=false
MONITORING_CAPTURE_RESUME_TEXT=false
MONITORING_CAPTURE_RESUME_BUILD_TEXT=false
MONITORING_CAPTURE_CLIENT_METADATA=false

# Voice engine (STT/TTS via /ws/voice)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=REPLACE_WITH_DEEPGRAM_KEY
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=1.3
SESSION_JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET
REDIS_SESSION_ENABLED=false
# REDIS_URL=redis://localhost:6379/0
